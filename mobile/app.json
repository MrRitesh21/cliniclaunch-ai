{
  "expo": {
    "name": "ClinicX Doctor",
    "slug": "clinicx-doctor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0891B2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.clinicx.doctor",
      "infoPlist": {
        "NSCameraUsageDescription": "ClinicX uses your camera to scan medical records, lab reports, and paper prescriptions.",
        "NSPhotoLibraryUsageDescription": "ClinicX requires photo library access to attach existing patient documents to health records.",
        "NSFaceIDUsageDescription": "Enable Face ID to quickly and securely unlock your ClinicX doctor dashboard.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0891B2"
      },
      "package": "app.clinicx.doctor",
      "allowBackup": false,
      "usesCleartextTraffic": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow ClinicX to use Face ID for fast and secure login."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ClinicX to access the camera to capture clinical records."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0891B2"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "clinicx-doctor-app"
      }
    }
  }
}
