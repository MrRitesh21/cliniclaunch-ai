# Copy to .env locally; keep permissions 0600. Never commit real values.
# VITE_* values are public: ONLY publishable/anon keys, never service-role keys.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server runtime configuration. Populate through a deployment secret manager.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@clinicx.in
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
CRON_KEY=

# AI Gateway configuration (Choose ANY ONE key or configure in Admin UI at /admin/ai)
# Option 1: OpenRouter (Recommended - access 100+ models with 1 key)
OPENROUTER_API_KEY=
# Option 2: OpenAI (ChatGPT 4o-mini, 4o)
OPENAI_API_KEY=
# Option 3: Google Gemini (Free tier, fast)
GEMINI_API_KEY=
# Option 4: Groq (Ultra-fast Llama-3.3 70B, free tier)
GROQ_API_KEY=
# Option 5: Anthropic Claude (Claude 3.5 Sonnet / Haiku)
ANTHROPIC_API_KEY=
# Option 6: DeepSeek / Custom
DEEPSEEK_API_KEY=

# Remote migrations are NEVER part of application startup or builds.
# Explicit operator-only REMOTE_DB_URL and CLINICX_ALLOW_REMOTE_MIGRATIONS=yes
# must be provided at invocation time; deliberately not enabled in this file.
