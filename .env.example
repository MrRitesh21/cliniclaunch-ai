# Copy to .env locally; keep permissions 0600. Never commit real values.
# VITE_* values are public: ONLY publishable/anon keys, never service-role keys.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server runtime configuration. Populate through a deployment secret manager.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@clinicx.in
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
CRON_KEY=

# Remote migrations are NEVER part of application startup or builds.
# Explicit operator-only REMOTE_DB_URL and CLINICX_ALLOW_REMOTE_MIGRATIONS=yes
# must be provided at invocation time; deliberately not enabled in this file.
