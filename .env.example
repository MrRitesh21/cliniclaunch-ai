# ==============================================================================
# ClinicX Production & Development Environment Configuration (.env.example)
# ==============================================================================
# IMPORTANT: Copy this file to '.env' or '.env.local' and populate with real values.
# NEVER commit your real '.env' file or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE & SUPABASE BACKEND (Required)
# ------------------------------------------------------------------------------
# Supabase API Endpoint URL (Public/Server)
SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co

# Supabase Anonymous/Publishable API Key (Public-Safe client & server key)
# Note: Ensure Row Level Security (RLS) is enabled on all database tables.
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here

# Supabase Service Role Key (SERVER-ONLY - NEVER expose to client/browser!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 2. APPLICATION HOST & SITE URL
# ------------------------------------------------------------------------------
APP_URL=https://clinicx.digiwil.com
VITE_APP_URL=https://clinicx.digiwil.com

# ------------------------------------------------------------------------------
# 3. PAYMENTS (Razorpay Integration)
# ------------------------------------------------------------------------------
# Razorpay Key ID (Client & Server)
RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id_here
VITE_RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id_here

# Razorpay Key Secret (SERVER-ONLY - Keep strictly secret!)
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Razorpay Webhook Signing Secret (SERVER-ONLY - For payment verification)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. WHATSAPP AUTOMATION & BAILEYS GATEWAY
# ------------------------------------------------------------------------------
# Baileys WhatsApp Bridge HTTP Endpoint
BAILEYS_URL=https://your-baileys-whatsapp-gateway.onrender.com

# Cron Auth Key (For triggering background WhatsApp automation cron jobs)
CRON_KEY=your_secure_random_cron_secret_key_here
VITE_CRON_KEY=your_secure_random_cron_secret_key_here

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Resend Integration)
# ------------------------------------------------------------------------------
# Resend API Key (SERVER-ONLY - For sending invitation & alert emails)
RESEND_API_KEY=re_your_resend_api_key_here

# ------------------------------------------------------------------------------
# 6. AI ENGINE & OPENROUTER / LOVABLE SERVICES
# ------------------------------------------------------------------------------
# OpenRouter API Key (SERVER-ONLY - For AI assistant & SEO generation)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Lovable Connector API Key (SERVER-ONLY - Optional backup AI/Email gateway)
LOVABLE_API_KEY=your_lovable_api_key_here

# ------------------------------------------------------------------------------
# 7. GOOGLE MAPS & REVIEWS INTEGRATION
# ------------------------------------------------------------------------------
# Google Maps / Places API Key (For Google Reviews sync & place searching)
GOOGLE_MAPS_API_KEY=AIzaSy_your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# 8. REDIS & BACKGROUND QUEUES (Upstash / Redis)
# ------------------------------------------------------------------------------
# Redis Server Connection URL or Host/Port (SERVER-ONLY)
REDIS_URL=redis://default:your_redis_password@your-redis-host:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Upstash REST API Redis (Optional REST cache backend)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
