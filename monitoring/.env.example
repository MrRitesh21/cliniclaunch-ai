GF_SECURITY_ADMIN_USER=admin
# Use a long random password: openssl rand -base64 24
GF_SECURITY_ADMIN_PASSWORD=
GF_SERVER_ROOT_URL=https://grafana.your-domain.com

# Host:port (no scheme) of the telemetry service exposing /metrics.
BACKEND_METRICS_HOST=clinicx-observability.onrender.com:443
# Must equal METRICS_TOKEN in observability/.env
METRICS_TOKEN=

# ---- Alertmanager: Discord ----
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ---- Alertmanager: Telegram ----
# Create a bot with @BotFather; get the chat id from @userinfobot or getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Alertmanager: Email (SMTP) ----
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=alerts@your-domain.com
ALERT_EMAIL_TO=oncall@your-domain.com
