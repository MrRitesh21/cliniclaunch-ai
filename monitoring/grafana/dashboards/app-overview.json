{
  "uid": "clinicx-app-overview",
  "title": "ClinicX — Application Overview",
  "tags": ["clinicx", "backend"],
  "timezone": "browser",
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat",
      "title": "Up",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ]
        }
      },
      "targets": [{ "expr": "up{job=\"clinicx-backend\"}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "clinicx_uptime_seconds", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Version / build",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "name"
      },
      "targets": [
        {
          "expr": "clinicx_build_info",
          "legendFormat": "{{version}} · {{build}} · {{commit}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Restarts",
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 0 },
      "targets": [{ "expr": "clinicx_process_restarts_total", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "5xx rate",
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "targets": [{ "expr": "clinicx:http_error_ratio:5xx5m", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "In-flight",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 0 },
      "targets": [{ "expr": "sum(clinicx_http_requests_in_flight)", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Req/s",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
      "targets": [{ "expr": "clinicx:http_requests:rate5m", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Request rate by status class",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 12, "stacking": { "mode": "normal" } }
        }
      },
      "targets": [
        {
          "expr": "sum by (status_class) (rate(clinicx_http_requests_total[5m]))",
          "legendFormat": "{{status_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "clinicx:http_latency_seconds:p50", "legendFormat": "p50", "refId": "A" },
        { "expr": "clinicx:http_latency_seconds:p95", "legendFormat": "p95", "refId": "B" },
        { "expr": "clinicx:http_latency_seconds:p99", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error ratio (4xx / 5xx)",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        { "expr": "clinicx:http_error_ratio:4xx5m", "legendFormat": "4xx", "refId": "A" },
        { "expr": "clinicx:http_error_ratio:5xx5m", "legendFormat": "5xx", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory (heap used / total / RSS)",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "clinicx_nodejs_heap_size_used_bytes",
          "legendFormat": "heap used",
          "refId": "A"
        },
        {
          "expr": "clinicx_nodejs_heap_size_total_bytes",
          "legendFormat": "heap total",
          "refId": "B"
        },
        { "expr": "clinicx_process_resident_memory_bytes", "legendFormat": "rss", "refId": "C" }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU + event-loop lag",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 12 },
      "targets": [
        {
          "expr": "rate(clinicx_process_cpu_seconds_total[5m])",
          "legendFormat": "cpu cores",
          "refId": "A"
        },
        {
          "expr": "clinicx_nodejs_eventloop_lag_p99_seconds",
          "legendFormat": "loop lag p99 (s)",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Slow requests (> threshold)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum by (route) (rate(clinicx_http_slow_requests_total[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top routes by p95 latency",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "sortBy": [{ "displayName": "Value", "desc": true }] },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (rate(clinicx_http_request_duration_seconds_bucket[5m]))))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP status codes",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 20 }
        }
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(clinicx_http_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    }
  ]
}
