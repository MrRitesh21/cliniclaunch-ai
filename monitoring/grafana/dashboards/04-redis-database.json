{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "Redis Status",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "redis_up", "legendFormat": "Redis Status" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "HEALTHY", "color": "green" },
                "0": { "text": "DOWN", "color": "red" }
              }
            }
          ]
        }
      }
    },
    {
      "title": "Database Status",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "database_up", "legendFormat": "DB Status" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "HEALTHY", "color": "green" },
                "0": { "text": "DOWN", "color": "red" }
              }
            }
          ]
        }
      }
    },
    {
      "title": "Redis Query Duration (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(redis_command_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P95 Latency"
        }
      ]
    },
    {
      "title": "Supabase Query Duration (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(database_query_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P95 DB Latency"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["saas", "redis", "database"],
  "title": "04 - Redis & Database Health",
  "uid": "redis-database"
}
