# ClinicX telemetry service (backend side) — copy to .env and fill in.
# Never commit real values.

NODE_ENV=production
HOST=0.0.0.0
PORT=8081

# ---- identity (shows up as Prometheus labels + log fields) ----
SERVICE_NAME=clinicx-observability
SERVICE_VERSION=1.0.0
BUILD_NUMBER=local
GIT_COMMIT=unknown

# ---- logging ----
LOG_LEVEL=info
# Render Free has an ephemeral disk: keep false there and read logs from stdout.
# Set true when a volume is mounted at ./logs (Docker/VPS).
LOG_TO_FILE=false
LOG_DIR=logs
LOG_ROTATION_FREQUENCY=daily
LOG_ROTATION_MAX_FILES=7
LOG_ROTATION_SIZE=20m

# ---- auth for telemetry surfaces ----
# openssl rand -hex 24
TELEMETRY_INGEST_TOKEN=
# Required by Prometheus as X-Metrics-Token. Strongly recommended in production.
METRICS_TOKEN=
# Optional extra lock: comma-separated IPs allowed to scrape /metrics.
METRICS_ALLOWED_IPS=

# ---- dependencies ----
SUPABASE_URL=https://your-supabase-host
SUPABASE_PUBLISHABLE_KEY=
# Cheap always-present table used for the readiness query.
READINESS_TABLE=plans
REDIS_URL=redis://default:password@host:6379

# ---- tuning ----
SLOW_REQUEST_MS=500
PROBE_TIMEOUT_MS=2500
PROBE_CACHE_MS=10000
INGEST_MAX_BODY_BYTES=131072
